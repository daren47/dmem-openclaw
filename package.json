{
  "name": "@dmem/dmem-openclaw",
  "version": "2026.5.10",
  "description": "OpenClaw plugin for dmem long-term memory search and recent context recall.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daren47/dmem-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/daren47/dmem-openclaw/issues"
  },
  "homepage": "https://github.com/daren47/dmem-openclaw#readme",
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --external:openclaw --outfile=dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "openclaw": "^2026.5.7"
  }
}
